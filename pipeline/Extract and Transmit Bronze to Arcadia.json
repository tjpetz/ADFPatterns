{
	"name": "Extract and Transmit Bronze to Arcadia",
	"properties": {
		"description": "Encrypt and transmit file to Arcadia.  Demonstrate checking for required set of files.\n\nThis sends files not already extracted from the bronze layer.  The extract layer is used to save a copy of the outbound file.",
		"activities": [
			{
				"name": "List of all bronze files",
				"description": "Get a list of all files for the humana from the leaf level of the bronze lake.",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_datalake_bronze_source_leaf",
						"type": "DatasetReference",
						"parameters": {
							"SystemName": {
								"value": "@pipeline().parameters.sourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems",
						"itemName",
						"itemType"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "List of all extract files",
				"description": "Get a leaf level list of all the extracted files.",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_datalake_extract_source_leaf",
						"type": "DatasetReference",
						"parameters": {
							"targetSystem": {
								"value": "@pipeline().parameters.targetName",
								"type": "Expression"
							},
							"sourceDataClass": {
								"value": "@pipeline().parameters.sourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Select files to extract",
				"description": "Filter out from the existing bronze files any we've already sent.  Note in the comparison we need to add the .gpg extension to the bronze file name to match the extract filename.",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "List of all bronze files",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "List of all extract files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List of all bronze files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(contains(activity('List of all extract files').output.childItems, \njson(\n    concat('{\"name\": ' , '\"', item().name, '.gpg\", ',\n            '\"type\": \"File\"}'))\n    )\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "For Each Bronze File",
				"description": "Encrypt and copy to the extract layer and then send to Arcadia each bronze file we've not sent",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Select files to extract",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "List of all target files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Select files to extract').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "PGP Encrypt File",
							"description": "Simulate PGP Encrypting the data by copying the file from bronze to extract with an encrypted file name.",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Set variable1",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set variable2",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set variable3",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFolderPath": {
											"value": "@concat(pipeline().parameters.SourceName, '/*/*/*/*')",
											"type": "Expression"
										},
										"wildcardFileName": {
											"value": "@item().name",
											"type": "Expression"
										},
										"deleteFilesAfterCompletion": false
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_datalake_bronze_source_file",
									"type": "DatasetReference",
									"parameters": {
										"SourceName": {
											"value": "@pipeline().parameters.sourceName",
											"type": "Expression"
										},
										"BronzeFileName": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_datalake_extract_target_encrypted_file",
									"type": "DatasetReference",
									"parameters": {
										"TargetSystem": {
											"value": "@pipeline().parameters.targetName",
											"type": "Expression"
										},
										"SourceSystem": {
											"value": "@pipeline().parameters.sourceName",
											"type": "Expression"
										},
										"EncryptedFileName": {
											"value": "@concat(item().name, '.gpg')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Transmit the file if it does not exist",
							"description": "If the file is not already sent to arcadia, send it.",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "PGP Encrypt File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@contains(\n    activity('List of all target files').output.childItems,\n    \n        json(  \n        concat('{\"name\": \"', string(item().name), '.gpg\", ',\n        '\"type\": \"File\"}')\n        )\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy Extract File to Target",
										"description": "Copy the encrypted extract file to the arcadia sftp target",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings"
												}
											},
											"enableStaging": false,
											"preserve": []
										},
										"inputs": [
											{
												"referenceName": "ds_datalake_extract_target_encrypted_file",
												"type": "DatasetReference",
												"parameters": {
													"TargetSystem": {
														"value": "@pipeline().parameters.targetName",
														"type": "Expression"
													},
													"SourceSystem": {
														"value": "@pipeline().parameters.sourceName",
														"type": "Expression"
													},
													"EncryptedFileName": {
														"value": "@concat(item().name, '.gpg')",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_arcadia_target_file",
												"type": "DatasetReference",
												"parameters": {
													"TargetFileName": {
														"value": "@activity('Select files to extract').output",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						},
						{
							"name": "Set variable1",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Debug1",
								"value": {
									"value": "@string(json(\n    \n    concat('{\"name\": \"', string(item().name), '.gpg\", ',\n    '\"type\": \"File\"}')\n    )\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set variable2",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Debug2",
								"value": {
									"value": "@string(contains(\n    activity('List of all target files').output.childItems,\n    \n        json(  \n        concat('{\"name\": \"', string(item().name), '.gpg\", ',\n        '\"type\": \"File\"}')\n        )\n))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set variable3",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Debug3",
								"value": {
									"value": "@string(item().name)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "List of all target files",
				"description": "Get a list of the all the files currently in the target.  Compute the list here to avoid recomputing it within the for each loop.",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_arcadia_target_leaf",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			}
		],
		"parameters": {
			"SourceName": {
				"type": "string",
				"defaultValue": "humana"
			},
			"TargetName": {
				"type": "string",
				"defaultValue": "arcadia"
			}
		},
		"variables": {
			"Debug1": {
				"type": "String"
			},
			"Debug2": {
				"type": "String"
			},
			"Debug3": {
				"type": "String"
			},
			"Debug4": {
				"type": "String"
			}
		},
		"folder": {
			"name": "20 Targets/Arcadia"
		},
		"annotations": []
	}
}