{
	"name": "Source To Raw Copy Once With Filter",
	"properties": {
		"description": "Copy source files to the raw layer of the lake.  Each file in source is copied once and only once.  Files are filtered rather than burying them deep in an if condition.",
		"activities": [
			{
				"name": "Get List of Source Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_binary",
						"type": "DatasetReference",
						"parameters": {
							"filepath": "humana"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Get List of Raw files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_datalake_raw_source_leaf",
						"type": "DatasetReference",
						"parameters": {
							"SystemName": {
								"value": "@pipeline().parameters.sourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "For Each Source File",
				"description": "Copy the source file to the raw layer of the lake.",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Select Source Files to Copy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Select Source Files to Copy').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Copy Source to Raw",
							"description": "Copy the source file to the Raw layer of the data lake.",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": false,
										"deleteFilesAfterCompletion": false
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_source_binary_file",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@item().name ",
											"type": "Expression"
										},
										"sourceRootFolder": {
											"value": "@pipeline().parameters.sourceName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_datalake_raw_target",
									"type": "DatasetReference",
									"parameters": {
										"SystemName": {
											"value": "@pipeline().parameters.sourceName",
											"type": "Expression"
										},
										"RawFileName": {
											"value": "@item().name ",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Classify File Type",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Copy Source to Raw",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Classify Humana File",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"FileName": {
										"value": "@item().name ",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Categorize and Unzip to Bronze",
							"description": "Unzip the humana file and place it into category folders in the data lake",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Filter out files already in Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"enableStaging": false
							}
						},
						{
							"name": "Filter out files already in Bronze",
							"description": "Remove any files already in the bronze layer of the lake.",
							"type": "Filter",
							"dependsOn": [
								{
									"activity": "Classify File Type",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": []
						}
					]
				}
			},
			{
				"name": "Select Source Files to Copy",
				"description": "Filter the source list to remove any files already in the raw layer of the lake.",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get List of Source Files",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get List of Raw files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get List of Source Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(contains(activity('Get List of Raw files').output.childItems, item()))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"sourceName": {
				"type": "string",
				"defaultValue": "humana"
			}
		},
		"folder": {
			"name": "99 Prototypes"
		},
		"annotations": []
	}
}