{
	"name": "Extract and Transmit Bronze to Arcadia_copy1",
	"properties": {
		"description": "Encrypt and transmit file to Arcadia.  Demonstrate checking for required set of files.\n\nThis sends files not already extracted from the bronze layer.  The extract layer is used to save a copy of the outbound file.",
		"activities": [
			{
				"name": "List of all bronze files",
				"description": "Get a list of all files for the humana from the leaf level of the bronze lake.",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_datalake_bronze_source_leaf",
						"type": "DatasetReference",
						"parameters": {
							"SystemName": {
								"value": "@pipeline().parameters.sourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems",
						"itemName",
						"itemType"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "List of all extract files",
				"description": "Get a leaf level list of all the extracted files.",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_datalake_extract_source_leaf",
						"type": "DatasetReference",
						"parameters": {
							"targetSystem": {
								"value": "@pipeline().parameters.targetName",
								"type": "Expression"
							},
							"sourceDataClass": {
								"value": "@pipeline().parameters.sourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Select files to extract",
				"description": "Filter out from the existing bronze files any we've already sent.  Note in the comparison we need to add the .gpg extension to the bronze file name to match the extract filename.",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "List of all bronze files",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "List of all extract files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List of all bronze files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(contains(activity('List of all extract files').output.childItems, \njson(\n    concat('{\"name\": ' , '\"', item().name, '.gpg\", ',\n            '\"type\": \"File\"}'))\n    )\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Build List of File Types",
				"description": "Iterate over the collection of files building a new collection of just the file types.",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "List of all extract files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List of all extract files').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Set variable2",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "FileTypes",
								"value": {
									"value": "@split(split(item().name, '_')[2], '.')[0]",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set variable2",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Debug2",
								"value": {
									"value": "@string(split(split(item().name, '_')[2], '.')[0])",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Set variable3",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Build List of File Types",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Debug3",
					"value": {
						"value": "@string(createArray(pipeline().parameters.RequiredFiles))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Build List of File Types",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('FileTypes')",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(pipeline().parameters.RequiredFiles, item())",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filter1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(length(variables('FileTypes')), length(createArray(pipeline().parameters.RequiredFiles)))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			}
		],
		"parameters": {
			"SourceName": {
				"type": "string",
				"defaultValue": "humana"
			},
			"TargetName": {
				"type": "string",
				"defaultValue": "arcadia"
			},
			"RequiredFiles": {
				"type": "object",
				"defaultValue": "['REMBX', 'RECAP', 'missing']"
			}
		},
		"variables": {
			"FileTypes": {
				"type": "Array"
			},
			"Debug1": {
				"type": "String"
			},
			"Debug2": {
				"type": "String"
			},
			"Debug3": {
				"type": "String"
			}
		},
		"folder": {
			"name": "20 Targets/Arcadia"
		},
		"annotations": []
	}
}