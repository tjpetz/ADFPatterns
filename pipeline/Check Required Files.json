{
	"name": "Check Required Files",
	"properties": {
		"description": "Given a list of files and required file types return true if all the required files are present.\n\nNote, currently this only works with Humana files as it parses out the file type based on the humana naming conventions.\n\nParameters\n\nRequriedFiles - an array of file types that are required.\nFiles - an object of childItems that list a set of files.  This should come from a Get Metadata activity.",
		"activities": [
			{
				"name": "Build List of File Types",
				"description": "Iterate over the collection of files building a new collection of just the file types.",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.Files.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Add File to List",
							"description": "Add the file type to the FileType array.",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "FileTypes",
								"value": {
									"value": "@split(split(item().name, '_')[2], '.')[0]",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Filter matched files",
				"description": "Intersect the required files and available files.",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Build List of File Types",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('FileTypes')",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(pipeline().parameters.RequiredFiles, item())",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If All Files Present",
				"description": "The matched files list and the required files list must contain the same number of items when all required files are present.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filter matched files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(length(variables('FileTypes')), length(pipeline().parameters.RequiredFiles))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Set Return False",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelineReturnValue",
								"value": [
									{
										"key": "AllRequiredFilesExist",
										"value": {
											"type": "Boolean",
											"content": false
										}
									}
								],
								"setSystemVariable": true
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Set Return True",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelineReturnValue",
								"value": [
									{
										"key": "AllRequiredFilesExist",
										"value": {
											"type": "Boolean",
											"content": true
										}
									}
								],
								"setSystemVariable": true
							}
						}
					]
				}
			}
		],
		"parameters": {
			"RequiredFiles": {
				"type": "array",
				"defaultValue": [
					"REMBX",
					"RECAP",
					"missing"
				]
			},
			"Files": {
				"type": "object",
				"defaultValue": {
					"childItems": [
						{
							"name": "0138497_PE20250201_RECAP.TXT.gpg",
							"type": "File"
						},
						{
							"name": "0138497_PE20250201_REMBX.TXT.gpg",
							"type": "File"
						}
					]
				}
			}
		},
		"variables": {
			"FileTypes": {
				"type": "Array"
			},
			"Debug1": {
				"type": "String"
			},
			"Debug2": {
				"type": "String"
			},
			"Debug3": {
				"type": "String"
			}
		},
		"folder": {
			"name": "20 Targets/Arcadia"
		},
		"annotations": []
	}
}