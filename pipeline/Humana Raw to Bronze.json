{
	"name": "Humana Raw to Bronze",
	"properties": {
		"description": "Unzip and categorize Humana files from Raw into Bronze",
		"activities": [
			{
				"name": "Classify Humana File",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Classify Humana File",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"FileName": {
							"value": "@pipeline().parameters.FileItem.name",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Copy the file from raw classify and unzip",
				"description": "Copy the file from the raw layer to the classified folder in bronze.  Unzip the file in the process.",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Classify Humana File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings",
							"compressionProperties": {
								"type": "ZipDeflateReadSettings",
								"preserveZipFileNameAsFolder": false
							}
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_datalake_raw_source_file",
						"type": "DatasetReference",
						"parameters": {
							"SystemName": {
								"value": "@pipeline().parameters.System",
								"type": "Expression"
							},
							"RawFileName": {
								"value": "@pipeline().parameters.FileItem.Name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_datalake_bronze_target_file",
						"type": "DatasetReference",
						"parameters": {
							"SystemName": {
								"value": "@pipeline().parameters.System",
								"type": "Expression"
							},
							"Category": {
								"value": "@activity('Classify Humana File').output.pipelineReturnValue.FileClassification",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"FileItem": {
				"type": "object"
			},
			"ExistingBronzeFiles": {
				"type": "object"
			},
			"System": {
				"type": "string",
				"defaultValue": "humana"
			}
		},
		"folder": {
			"name": "Humana/Child Pipelines"
		},
		"annotations": []
	}
}