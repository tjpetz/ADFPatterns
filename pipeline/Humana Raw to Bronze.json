{
	"name": "Humana Raw to Bronze",
	"properties": {
		"description": "Unzip and categorize Humana files from Raw into Bronze",
		"activities": [
			{
				"name": "Wait1",
				"type": "Wait",
				"dependsOn": [
					{
						"activity": "Classify Humana File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"waitTimeInSeconds": 1
				}
			},
			{
				"name": "Classify Humana File",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Classify Humana File",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"FileName": {
							"value": "@pipeline().parameters.FileItem.name",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"FileItem": {
				"type": "object"
			},
			"ExistingBronzeFiles": {
				"type": "object"
			}
		},
		"folder": {
			"name": "Humana/Child Pipelines"
		},
		"annotations": []
	}
}