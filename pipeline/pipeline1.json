{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Get List of Source Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_binary",
						"type": "DatasetReference",
						"parameters": {
							"filepath": "humana"
						}
					},
					"fieldList": [
						"childItems",
						"itemName",
						"itemType",
						"lastModified"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Get List of Raw files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_raw_binary_root",
						"type": "DatasetReference",
						"parameters": {
							"sourceFolder": {
								"value": "@pipeline().parameters.sourceName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems",
						"itemName",
						"itemType",
						"lastModified"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "For Each Source File",
				"description": "Copy the source file to the raw layer of the lake if it does not already exist in the lake.",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get List of Source Files",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set rawFileArray",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get List of Source Files').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "If File Does Not Exist in Raw",
							"description": "Check if the file exists in Raw.  If not then copy it.  If it exists do nothing.",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Set currentItem",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@contains(variables('rawFileArray'), item())",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy Source to Raw",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"deleteFilesAfterCompletion": false
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings",
													"copyBehavior": "PreserveHierarchy"
												}
											},
											"enableStaging": false,
											"preserve": [
												"ACL",
												"Owner",
												"Group",
												"Attributes"
											]
										},
										"inputs": [
											{
												"referenceName": "ds_source_binary_file",
												"type": "DatasetReference",
												"parameters": {
													"fileName": {
														"value": "@variables('currentItem')",
														"type": "Expression"
													},
													"sourceRootFolder": {
														"value": "@pipeline().parameters.sourceName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_datalake_raw",
												"type": "DatasetReference",
												"parameters": {
													"SystemName": {
														"value": "@pipeline().parameters.sourceName",
														"type": "Expression"
													},
													"SubSystemName": "TempName",
													"RawFileName": {
														"value": "@variables('currentItem')",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						},
						{
							"name": "Set currentItem",
							"description": "set a currentItem variable to be used deeper in this activity as the item() property of the For Each is only available at the top level.",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "currentItem",
								"value": {
									"value": "@item().value.name",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Set rawFileArray",
				"description": "Convert the JSON list of files into a simple format for the compare operation.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get List of Raw files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "rawFileArray",
					"value": {
						"value": "@array(activity('Get List of Raw files').output.childItems)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"sourceName": {
				"type": "string",
				"defaultValue": "humana"
			}
		},
		"variables": {
			"rawFileArray": {
				"type": "Array"
			},
			"currentItem": {
				"type": "String"
			}
		},
		"annotations": []
	}
}