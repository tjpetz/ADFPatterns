{
	"name": "ds_datalake_raw_source_leaf",
	"properties": {
		"description": "Use this data set when getting a list of all files in the raw layer for a given System.  Organization is /System/YYYY/MM/DD.\n\nNote, uses wildcards in the path to support full traversal to the leaf level.",
		"linkedServiceName": {
			"referenceName": "ls_pattern_datalake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"SystemName": {
				"type": "string",
				"defaultValue": "humana"
			}
		},
		"folder": {
			"name": "20 Data Lake"
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"folderPath": {
					"value": "@concat(dataset().SystemName, '/*/*/*')",
					"type": "Expression"
				},
				"fileSystem": "raw"
			}
		}
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}